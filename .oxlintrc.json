{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react", "vitest"],
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist"],
  "overrides": [
    {
      "files": ["src/components/ui/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
